{
  "program": "DON Creator Program",
  "note": "All times are UTC. Amounts are in whole DON; the token has 9 decimals.",
  "projectHandle": "doncointhegame",
  "projectKeywords": ["doncoin", "doncoin.app"],
  "registrationHashtag": "#DONCreator",
  "maxQueryLength": 512,

  "rules": {
    "requireProjectMention": true,
    "requireAdLabel": true,
    "adLabels": ["#ad", "#advertisement", "#sponsored", "paid partnership"],
    "requireDisclaimer": true,
    "disclaimerKeywords": ["not an investment"],
    "bannedPhrases": [
      "to the moon", "moon soon", "100x", "1000x", "guaranteed return", "guaranteed profit",
      "price prediction", "price target", "will pump", "next bitcoin", "get rich",
      "financial advice", "passive income", "can't lose", "cannot lose"
    ],
    "excludeReplies": true,
    "onlyPostsAfterRegistration": true,
    "minAccountAgeDays": 183,
    "minFollowers": 1000
  },

  "scoring": {
    "repost": 3,
    "quote": 3,
    "reply": 2,
    "like": 1,
    "impressionsPerPoint": 100,
    "maxPostsPerMonth": 10
  },

  "fraud": {
    "minImpressionsForRateCheck": 1000,
    "maxEngagementRate": 0.25,
    "maxImpressionsPerFollower": 30,
    "dominantPostShare": 0.6
  },

